# Postgres (docker compose default)
DATABASE_URL=postgres://funder:funder@localhost:5433/funder_finder

# AI is OFF unless AI_ENABLED=true (a key alone does not turn it on — see BACKLOG #17)
AI_ENABLED=false
# AI provider — swap without code changes
AI_PROVIDER=anthropic
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_EXPLAIN=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ProPublica Nonprofit Explorer needs no key. Grants.gov search2 needs no key.

# Email (Resend). Without a verified domain, only the account owner's address receives mail.
RESEND_API_KEY=
EMAIL_FROM=Funder Finder <onboarding@resend.dev>

# Vercel Cron shared secret (cron routes use this, not a user session)
CRON_SECRET=

# Authentication (Better Auth). REQUIRED. Generate the secret with: openssl rand -base64 32
# Never commit a real value. Sessions, cookies and reset tokens are signed with it.
BETTER_AUTH_SECRET=
# Public URL of the app (used in password-reset links), e.g. http://localhost:3000 or https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Feature flags (true/false) — override src/config/flags.ts defaults
FLAG_BOARD_MEMBERS=
FLAG_AI_DRAFT=
FLAG_FULL_DASHBOARD=
FLAG_WEIGHT_TUNING=
