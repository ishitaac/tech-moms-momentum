# Postgres (docker compose default)
DATABASE_URL=postgres://funder:funder@localhost:5433/funder_finder

# AI is OFF unless AI_ENABLED=true (a key alone does not turn it on — see BACKLOG #17)
AI_ENABLED=false
# AI provider — swap without code changes
AI_PROVIDER=anthropic
AI_MODEL_EXTRACT=claude-haiku-5-5
AI_MODEL_EXPLAIN=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ProPublica Nonprofit Explorer needs no key. Grants.gov search2 needs no key.

# Email (Resend). Without a verified domain, only the account owner's address receives mail.
RESEND_API_KEY=
EMAIL_FROM=Funder Finder <onboarding@resend.dev>

# Vercel Cron shared secret
CRON_SECRET=

# Authentication (Better Auth). REQUIRED in production.
# Secret: generate with `openssl rand -base64 32`. Never commit the real value.
BETTER_AUTH_SECRET=
# Public URL of the app (used in password-reset links), e.g. https://funder-finder.vercel.app
BETTER_AUTH_URL=http://localhost:3000
# Optional: extra allowed origins, comma-separated (e.g. a preview URL)
BETTER_AUTH_TRUSTED_ORIGINS=
# Password reset emails use RESEND_API_KEY + EMAIL_FROM above. Without a key, dev prints the link to the server console.

# Feature flags (true/false) — override src/config/flags.ts defaults
FLAG_BOARD_MEMBERS=
FLAG_AI_DRAFT=
FLAG_FULL_DASHBOARD=
FLAG_WEIGHT_TUNING=
